<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="yugioh.interfaz.PanelCarta">
  <grid id="raiz" binding="panelCarta" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="4">
    <margin top="6" left="4" bottom="6" right="4"/>
    <constraints>
      <xy x="20" y="20" width="140" height="280"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="etched"/>
    <children>
      <component id="imagen" class="javax.swing.JLabel" binding="etiquetaImagen">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <minimum-size width="110" height="160"/>
            <preferred-size width="110" height="160"/>
            <maximum-size width="110" height="160"/>
          </grid>
        </constraints>
        <properties>
          <foreground color="-10193781"/>
          <horizontalAlignment value="0"/>
          <text value="Sin carta"/>
        </properties>
      </component>
      <component id="nombre" class="javax.swing.JLabel" binding="etiquetaNombre">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <minimum-size width="126" height="18"/>
            <preferred-size width="126" height="18"/>
            <maximum-size width="126" height="18"/>
          </grid>
        </constraints>
        <properties>
          <font size="11" style="1"/>
          <foreground color="-14800581"/>
          <horizontalAlignment value="0"/>
          <text value="-"/>
        </properties>
      </component>
      <component id="atk" class="javax.swing.JLabel" binding="etiquetaAtk">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="12" style="1"/>
          <foreground color="-4645860"/>
          <text value="ATK -"/>
        </properties>
      </component>
      <component id="def" class="javax.swing.JLabel" binding="etiquetaDef">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font size="12" style="1"/>
          <foreground color="-14796150"/>
          <text value="DEF -"/>
        </properties>
      </component>
      <component id="elegir" class="javax.swing.JButton" binding="botonElegir">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-14796150"/>
          <enabled value="false"/>
          <font size="12" style="1"/>
          <foreground color="-1"/>
          <text value="Elegir carta"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
